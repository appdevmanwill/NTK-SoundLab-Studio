{
  "manifest_version": 3,
  "name": "NTK SoundLab Media Grabber",
  "version": "1.1.0",
  "description": "Save captured audio as original, 320 kbps MP3 or 24-bit WAV, save video and HLS streams, or send media to NTK SoundLab.",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NTK SoundLab Media Grabber",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "webRequest",
    "tabs",
    "storage",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio-5090403114-fc98b.web.app/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "studio_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
